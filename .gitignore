# Files that are never committed. android/.gitignore and ios/.gitignore
# have more rules for their own folders.

# Secrets: Firebase config files (each developer creates them with
# `flutterfire configure`), signing keys and local environment files
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart
*.jks
*.keystore
**/android/key.properties
.env

# Flutter and Dart build output (created again by `flutter pub get`
# and `flutter run`)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
.pub-preload-cache/
build/
coverage/
**/doc/api/
**/generated_plugin_registrant.dart
app.*.symbols
# Built apps copied out of build/
*.apk
*.aab
*.ipa

# Android
.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/gradle-wrapper.jar
**/android/gradlew
**/android/gradlew.bat

# iOS
**/ios/**/DerivedData/
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# Editors (Android Studio, IntelliJ, VS Code)
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Operating system and misc
.DS_Store
Thumbs.db
*.log
*.swp
*.class
*.pyc
.history
